@startuml
skinparam defaultFontName Arial
skinparam monochrome true
title Task 3 - Brick Buster application database
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entityBackgroundColor white
entity "themes" as themes {
  id : INTEGER [PK]
  name : TEXT
  parent_id : INTEGER [FK, null]
}
entity "sets" as sets {
  set_num : TEXT [PK]
  name : TEXT
  year : INTEGER
  theme_id : INTEGER [FK]
  num_parts : INTEGER
}
entity "owned_sets" as owned_sets {
  set_num : TEXT [PK, FK]
  quantity : INTEGER > 0
}
entity "minifigs" as minifigs {
  fig_num : TEXT [PK]
  name : TEXT
  num_parts : INTEGER
}
entity "import_state" as import_state {
  id : INTEGER [PK] = 1
  ready : INTEGER in (0,1)
  generation : INTEGER >= 0
  completed_at : TEXT [null]
}
entity "inventories" as inventories {
  id : INTEGER [PK]
  version : INTEGER > 0
  set_num : TEXT [FK, null]
  fig_num : TEXT [FK, null]
  CHECK exactly one owner
  UNIQUE(owner, version)
}
entity "inventory_sets" as inventory_sets {
  inventory_id : INTEGER [PK, FK]
  set_num : TEXT [PK, FK]
  quantity : INTEGER > 0
}
entity "inventory_minifigs" as inventory_minifigs {
  inventory_id : INTEGER [PK, FK]
  fig_num : TEXT [PK, FK]
  quantity : INTEGER > 0
}
entity "inventory_parts" as inventory_parts {
  inventory_id : INTEGER [PK, FK]
  part_num : TEXT [PK, FK]
  color_id : INTEGER [PK, FK]
  is_spare : INTEGER [PK] in (0,1)
  quantity : INTEGER > 0
}
entity "parts" as parts {
  part_num : TEXT [PK]
  name : TEXT
}
entity "colors" as colors {
  id : INTEGER [PK]
  name : TEXT
}
themes |o--o{ themes : parent / children
themes ||--o{ sets
sets ||--o| owned_sets
sets |o--o{ inventories : set owner (XOR)
minifigs |o--o{ inventories : figure owner (XOR)
inventories ||--o{ inventory_parts
parts ||--o{ inventory_parts
colors ||--o{ inventory_parts
inventories ||--o{ inventory_minifigs
minifigs ||--o{ inventory_minifigs
inventories ||--o{ inventory_sets
sets ||--o{ inventory_sets : nested child
note right of inventories
  Exactly one of set_num / fig_num is non-null.
  UNIQUE(set_num, version); UNIQUE(fig_num, version).
  Select maximum version per owner; never sum versions.
  CSV inventories.set_num is resolved to either owner type.
end note
note bottom of inventory_parts
  Composite PK includes is_spare. Only is_spare=0 contributes.
  Part matching uses (part_num, color_id).
  Complete minifigures use fig_num; never expand their parts.
  Resolve nested sets without omission or double counting.
  Unverifiable contents cause a data error, not a build result.
end note
note right of owned_sets
  quantity: typeof(quantity)=integer AND quantity>0.
  Add increments; update replaces; remove deletes after confirmation.
  Commit all mutations; enable foreign_keys on every connection.
end note
note right of import_state
  One row (id=1). Publish ready and catalogue atomically.
  Failed reimport retains prior committed valid generation.
  No ready generation means calculations remain unavailable.
end note
@enduml
